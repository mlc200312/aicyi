{
  "openapi": "3.0.1",
  "info": {
    "title": "接口文档 UI 特性示例",
    "description": "本样例由 springdoc-openapi 2.5.0 的真实产物叠加特性示例接口生成，用于在取不到后端文档时离线展示 apidoc UI 的渲染能力。所有展示文本均在解析层做过 HTML 转义，模板直接输出。",
    "version": "1.0",
    "termsOfService": "https://github.com/mlc200312/aicyi",
    "contact": {
      "name": "Leon Min",
      "url": "https://github.com/mlc200312",
      "email": "15910436675@163.com"
    },
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  },
  "servers": [
    {
      "url": "http://localhost",
      "description": "本地开发环境（默认生效）"
    },
    {
      "url": "https://{host}/{basePath}",
      "description": "远程环境，地址含 server 变量",
      "variables": {
        "host": {
          "default": "api.example.com",
          "enum": [
            "api.example.com",
            "api-test.example.com"
          ],
          "description": "服务域名"
        },
        "basePath": {
          "default": "v1",
          "description": "上下文路径"
        }
      }
    },
    {
      "url": "/apidoc-mock",
      "description": "相对地址，按文档来源站点补全"
    }
  ],
  "paths": {
    "/demo/upload-file": {
      "post": {
        "tags": [
          "特性示例"
        ],
        "summary": "文件上传（multipart）",
        "description": "layui 2.2.2 的 upload 组件不支持自定义请求头，无法携带 Bearer Token，因此 UI 对含文件字段的请求统一改用原生 FormData 提交。",
        "operationId": "demoUploadFile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "文件与普通表单字段可以混排",
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DemoUploadReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          },
          "400": {
            "description": "参数校验失败",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    },
    "/demo/form-urlencoded": {
      "post": {
        "tags": [
          "特性示例"
        ],
        "summary": "传统表单提交（urlencoded）",
        "description": "请求体按表单字段展开为多个输入框，提交时以 x-www-form-urlencoded 编码。",
        "operationId": "demoFormUrlencoded",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/DemoFormReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "提交成功",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    },
    "/demo/{demoId}/status": {
      "patch": {
        "tags": [
          "特性示例",
          "学生控制器"
        ],
        "summary": "变更状态（已废弃）",
        "description": "该接口仅用于展示 deprecated 与 PATCH 方法的渲染效果，已废弃且不再维护。",
        "operationId": "demoChangeStatus",
        "deprecated": true,
        "externalDocs": {
          "description": "状态机说明",
          "url": "https://github.com/mlc200312/aicyi"
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "demoId",
            "in": "path",
            "required": true,
            "description": "示例主键",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Api-Key",
            "in": "header",
            "required": false,
            "description": "开放平台密钥，作为普通 header 参数填写",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoStatusReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "变更成功",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    },
    "/demo/tree": {
      "get": {
        "tags": [
          "特性示例"
        ],
        "summary": "树查询（对象参数展平 + 响应头 + 多状态码）",
        "description": "query 参数 filter 是一个对象，UI 会把它展平成独立输入项；响应声明了自定义 header 与 404 / 500 分支。",
        "operationId": "demoTree",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "关键字，选填则不提交",
            "schema": {
              "type": "string",
              "example": "aicyi"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": true,
            "description": "查询条件对象",
            "schema": {
              "$ref": "#/components/schemas/DemoQueryReq"
            }
          },
          {
            "name": "X-Trace-Id",
            "in": "header",
            "required": false,
            "description": "链路追踪 id，非鉴权头，应保留在调试参数中",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "headers": {
              "X-Total-Count": {
                "description": "总条数",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-Request-Id": {
                "description": "本次请求 id",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DemoTreeResp"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          },
          "500": {
            "description": "服务端异常",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    },
    "/demo/{demoId}": {
      "delete": {
        "tags": [
          "特性示例"
        ],
        "summary": "删除（204 无响应体）",
        "description": "成功响应不声明 content，UI 应显示「无响应体」而不是报错。",
        "operationId": "demoDelete",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "demoId",
            "in": "path",
            "required": true,
            "description": "示例主键",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "删除成功，无响应体"
          },
          "404": {
            "description": "资源不存在",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    },
    "/demo/image": {
      "get": {
        "tags": [
          "特性示例"
        ],
        "summary": "二进制响应（image/png）",
        "description": "响应媒体类型为 image/png，UI 标记为二进制，调试时不按 JSON 解析。",
        "operationId": "demoImage",
        "parameters": [
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "图片边长像素",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 16,
              "maximum": 512,
              "default": 120
            }
          }
        ],
        "responses": {
          "200": {
            "description": "图片二进制流",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/demo/escape": {
      "get": {
        "tags": [
          "特性示例"
        ],
        "summary": "转义示例 & <b>粗体</b> \"引号\"",
        "description": "本接口的概要与说明含 < > & 与引号，用于肉眼确认展示文本已被转义而非解析成标签。",
        "operationId": "demoEscape",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "含特殊字符的查询词 & <tag>",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功 & <ok>",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          }
        }
      }
    },
