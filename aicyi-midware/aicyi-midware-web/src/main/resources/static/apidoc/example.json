  "components": {
    "schemas": {
      "DemoBase": {
        "type": "object",
        "description": "示例基类，通过 allOf 被子模型继承",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
