<?xml version="1.0" encoding="UTF-8"?>

<!-- 日志级别从低到高分为TRACE < DEBUG < INFO < WARN < ERROR < FATAL，如果设置为WARN，则低于WARN的信息都不会输出 -->
<!-- scan:当此属性设置为true时，配置文件如果发生改变，将会被重新加载，默认值为true，扫描间隔默认1分钟 -->
<!-- debug:当此属性设置为true时，将打印出logback内部日志信息，实时查看logback运行状态。默认值为false。 -->
<configuration scan="true">

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 可通过应用配置覆盖：aicyi.logging.path / aicyi.logging.max-history / aicyi.logging.max-file-size -->
    <springProperty scope="context" name="log.path" source="aicyi.logging.path" defaultValue="./logs"/>
    <springProperty scope="context" name="maxHistory" source="aicyi.logging.max-history" defaultValue="15"/>
    <springProperty scope="context" name="maxFileSize" source="aicyi.logging.max-file-size" defaultValue="10MB"/>
    <springProperty scope="context" name="totalSizeCap" source="aicyi.logging.total-size-cap" defaultValue="20GB"/>
    <springProperty scope="context" name="springAppName" source="spring.application.name"/>

    <!-- 彩色日志 -->
    <!-- 彩色日志依赖的渲染类 -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex"
                    converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>
    <!-- 彩色日志格式 -->
    <!--
    yellow：黄色
    cyan：青色
    magenta：洋红色
    blue:蓝色
    red：红色
    white：白色
    highlight：日志级别高亮显示
    -->
    <!-- traceId 由 midware-web TraceIdFilter 写入 MDC（key=traceId） -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%yellow(%d) [%t] %cyan([${springAppName:-},%X{traceId:-}]) %highlight([%-5level]) %magenta([%logger{15}]) - %highlight(%m) %n"/>
    <property name="SIMPLE_CONSOLE_LOG_PATTERN"
              value="%d [%t] [${springAppName:-},%X{traceId:-}] [%p] [%c] - %m %n"/>

    <!--输出到控制台-->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!--此日志appender是为开发使用，只配置最低级别，控制台输出的日志级别是大于或等于此级别的日志信息-->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>debug</level>
        </filter>
    </appender>

    <appender name="errorAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/error.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 历史文件统一滚入与日志同名的子目录，避免与活动文件混放；旧路径历史文件不再维护，自然过期后清理 -->
            <fileNamePattern>${log.path}/error/error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <!--全量日志总容量上限，防止磁盘写满-->
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>

        <!-- 此日志文件只记录ERROR级别的 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <appender name="warnAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/warn.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/warn/warn.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>

        <!-- 此日志文件只记录WARN级别的 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <appender name="accessAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/access.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/access/access.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="clientAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/client.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/client/client.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="performanceAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/performance.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/performance/performance.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="scheduleAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/schedule.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/schedule/schedule.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="messageAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/message.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 历史文件统一滚入子目录，避免与活动文件混放 -->
            <fileNamePattern>${log.path}/message/message.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="bizAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/biz.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 历史文件统一滚入子目录，避免与活动文件混放 -->
            <fileNamePattern>${log.path}/biz/biz.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="daoAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/dao.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/dao/dao.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="allAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/all.log</file>
        <encoder>
            <!--日志文件输出格式-->
            <Pattern>${SIMPLE_CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>

        <!-- 日志记录器的滚动策略，按日期+大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/all/all.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${maxFileSize}</maxFileSize>
            <!--日志文件保留天数-->
            <maxHistory>${maxHistory}</maxHistory>
            <totalSizeCap>${totalSizeCap}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 分类日志 logger（与 LoggerType 对应），additivity 关闭避免重复写入 all -->
    <logger name="ACCESS" level="info" additivity="false">
        <appender-ref ref="accessAppender"/>
    </logger>

    <logger name="CLIENT" level="info" additivity="false">
        <appender-ref ref="clientAppender"/>
    </logger>

    <logger name="PERFORMANCE" level="info" additivity="false">
        <appender-ref ref="performanceAppender"/>
    </logger>

    <logger name="SCHEDULE" level="info" additivity="false">
        <appender-ref ref="scheduleAppender"/>
    </logger>

    <logger name="MESSAGE" level="info" additivity="false">
        <appender-ref ref="messageAppender"/>
    </logger>

    <logger name="BIZ" level="info" additivity="false">
        <appender-ref ref="bizAppender"/>
    </logger>

    <logger name="DAO" level="info" additivity="false">
        <appender-ref ref="daoAppender"/>
    </logger>

    <!-- 单一 root：控制台 + 全量日志 + WARN/ERROR 分级落盘（warn/error appender 自带级别过滤器） -->
    <root level="info">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="allAppender"/>
        <appender-ref ref="warnAppender"/>
        <appender-ref ref="errorAppender"/>
    </root>

</configuration>
