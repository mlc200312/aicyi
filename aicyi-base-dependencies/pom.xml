<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.aicyi.base</groupId>
    <artifactId>aicyi-base-dependencies</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <packaging>pom</packaging>
    <name>aicyi base dependencies</name>
    <description>aicyi base dependencies</description>

    <!-- 父工程继承 spring-boot-starter-parent：统一管理 Boot 依赖版本与构建插件 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.8</version>
        <relativePath/>
    </parent>

    <!-- ============================================================================================
         版本号一律集中在本 properties 中管理，dependencyManagement 只做引用；
         子模块（含 aicyi-example 各模块）禁止再写 <version>。
         ============================================================================================ -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- JDK 编译 / 运行版本统一 17 -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- ==================== 一、核心基线（生产稳妥组合，严格固定） ====================
             禁止为修复第三方 CVE 而上调以下四项；
             禁止跳到 Spring Boot 3.3/3.4/3.5、Spring Cloud Alibaba 2022.x/2025.x、MyBatis-Plus 3.5.1x 等非指定版本。 -->
        <!-- Spring Boot 版本由 spring-boot-starter-parent 继承，此处显式声明供插件引用 -->
        <spring-boot.version>3.2.8</spring-boot.version>
        <!-- Spring Cloud 2023.0.3 (Leyton) -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <!-- Spring Cloud Alibaba 2023.0.1.2：Nacos / Sentinel / Seata 的内部构件版本全部由
             spring-cloud-alibaba-dependencies BOM 托管，禁止在本工程私自覆盖 -->
        <spring-cloud-alibaba.version>2023.0.1.2</spring-cloud-alibaba.version>
        <!-- MyBatis-Plus 3.5.7：Spring Boot 3.x 必须搭配 mybatis-plus-spring-boot3-starter -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>

        <!-- ==================== 二、ORM 配套版本（与 MyBatis-Plus 3.5.7 官方声明对齐） ==================== -->
        <!-- mybatis-spring-boot-starter 3.x 支持 Spring Boot 3.x / Jakarta EE -->
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
        <!-- mybatis 3.5.16：mybatis-plus-core 3.5.7 官方声明的配套版本。
             显式对齐可避免 Maven「就近优先」把 mybatis 调解到 mybatis-spring-boot-starter 传递的 3.5.14 -->
        <mybatis.version>3.5.16</mybatis.version>
        <!-- jsqlparser 4.9：mybatis-plus 3.5.7 强制要求（其 extension 引用了 4.7 中不存在的
             TableStatement / MergeDelete / Contains 等 8 个类）。
             已实测 pagehelper 6.1.0 在 jsqlparser 4.9 下的 count / orderBy / SqlServer 分页改写全部正常 -->
        <jsqlparser.version>4.9</jsqlparser.version>
        <pagehelper-spring-boot.version>2.1.0</pagehelper-spring-boot.version>
        <!-- mybatis-generator：逆向工程代码生成器（仅 test 作用域使用） -->
        <mybatis-generator.version>1.3.5</mybatis-generator.version>

        <!-- ==================== 三、中间件 / 工具（Spring Boot BOM 未托管，需本工程自行管理） ==================== -->
        <!-- springdoc-openapi 2.x 取代 springfox（springfox 不兼容 Spring Boot 3） -->
        <springdoc.version>2.5.0</springdoc.version>
        <!-- redisson 3.27.x 支持 Spring Boot 3.2 -->
        <redisson.version>3.27.2</redisson.version>
        <!-- mapstruct 1.6.x 编译期 Bean 映射（取代 Orika），完整支持 JDK 17 -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <reflections.version>0.10.2</reflections.version>
        <dom4j.version>2.1.3</dom4j.version>
        <commons-collections4.version>4.4</commons-collections4.version>
        <poi.version>5.5.1</poi.version>
        <easyexcel.version>3.3.2</easyexcel.version>
        <zxing.version>3.5.4</zxing.version>
        <jjwt.version>0.13.0</jjwt.version>
        <xxl-job.version>2.5.0</xxl-job.version>
        <twilio.version>9.14.1</twilio.version>
        <yunpian-java-sdk.version>1.2.5</yunpian-java-sdk.version>
        <uuid-creator.version>6.1.1</uuid-creator.version>

        <!-- ==================== 四、【安全CVE修复覆盖】覆盖 spring-boot-dependencies 的官方版本属性 ====================
             以下属性名均为 spring-boot-dependencies 3.2.8 自带的占位符属性名，
             覆盖属性即可让 BOM 托管的全部同族构件统一生效，无需逐个声明依赖，也不会破坏核心基线。
             原则：只在同一大分支内升到安全修复版，不跨大版本。 -->
        <!-- 【安全CVE修复覆盖】Tomcat 10.1.26 (Boot 3.2.8 BOM) -> 10.1.59
             CVE-2025-24813（严重 RCE，CVSS 9.8，修复于 10.1.35）、
             CVE-2024-50379 / CVE-2024-56337（RCE，修复于 10.1.34）及后续 10.1.x 安全公告 -->
        <tomcat.version>10.1.59</tomcat.version>
        <!-- 【安全CVE修复覆盖】Netty 4.1.111.Final (Boot 3.2.8 BOM) -> 4.1.137.Final
             CVE-2024-47535（修复 4.1.115）、CVE-2025-24970 / CVE-2025-25193（修复 4.1.118）、
             CVE-2025-55163（修复 4.1.124）、CVE-2025-58057（修复 4.1.125）及后续 4.1.x 安全公告。
             注意：4.2.x 属于新大分支，按约束不跨越 -->
        <netty.version>4.1.137.Final</netty.version>
        <!-- 【安全CVE修复覆盖】commons-lang3 3.13.0 (Boot 3.2.8 BOM) -> 3.18.0
             CVE-2025-48924（ClassUtils.getClass 不受控递归导致 StackOverflowError，
             影响 [3.0, 3.18.0)，修复于 3.18.0） -->
        <commons-lang3.version>3.18.0</commons-lang3.version>

        <!-- ==================== 五、Boot BOM 托管构件的同分支补丁版（非 CVE 驱动，仅避免版本回退） ====================
             这两项在升级前已由本工程显式声明，为保持既有生效版本不因改用 BOM 而回退，
             统一改为覆盖 Boot 官方属性；如需完全沿用 BOM，删除对应属性行即可 -->
        <!-- Boot 3.2.8 BOM 为 1.16.1 -->
        <commons-codec.version>1.17.1</commons-codec.version>
        <!-- Boot 3.2.8 BOM 为 2.3.33 -->
        <freemarker.version>2.3.34</freemarker.version>

        <!-- ==================== 六、【安全CVE修复覆盖】Boot BOM 未托管、需本工程显式管理的构件 ==================== -->
        <!-- 【安全CVE修复覆盖】commons-io 2.11.0 -> 2.21.0
             CVE-2024-47554（高危 DoS，CVSS 7.5，影响 [2.0, 2.14.0)）。
             同时对齐 POI 5.5.1 官方声明的 2.21.0：POI 5.2.4+ 依赖
             UnsynchronizedByteArrayOutputStream$Builder，运行在 2.11.0 上会 NoSuchMethodError -->
        <commons-io.version>2.21.0</commons-io.version>
        <!-- 【安全CVE修复覆盖】httpclient / httpclient-cache -> 4.5.14（4.5.x 分支终止版）
             CVE-2020-13956（URI 解析不一致，修复于 4.5.13）。
             原 httpclient-cache 4.5.2 由 yunpian-java-sdk 1.2.5 -> httpasyncclient-cache 4.1.2 传递引入；
             同族构件必须同版本，故 httpclient 一并对齐到 4.5.14。httpclient 5.x 属于新大分支，不跨越 -->
        <httpclient4.version>4.5.14</httpclient4.version>
        <!-- 【安全CVE修复覆盖·预防性加固】protobuf-java -> 3.25.9（CVE-2024-7254，高危 DoS，CVSS 7.5，修复于 3.25.5）。
             说明：mysql-connector-j 交由 Boot BOM 托管后，BOM 的托管条目自带 protobuf-java 排除，
             当前依赖树中已不存在 protobuf-java（原 3.21.9 漏洞已随之消除）。
             保留本条为预防性护栏：若后续引入 gRPC / Nacos 等再次传递 protobuf-java，将直接落在已修复版本。
             4.x 属于新大分支，不跨越 -->
        <protobuf-java.version>3.25.9</protobuf-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- Spring Boot 依赖版本由父工程 spring-boot-starter-parent 统一管理，无需重复导入 -->

            <!-- Spring Data 版本由 spring-boot-starter-parent 统一管理，不再单独声明 -->

            <!-- Spring Cloud -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba：置于 spring-cloud-dependencies 之后，共享构件以 Spring Cloud 版本为准。
                 Nacos / Sentinel / Seata 客户端版本一律由该 BOM 托管，本工程不做任何覆盖 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- jakarta：servlet / mail / xml.bind 等 API 版本均由 spring-boot-starter-parent 托管，此处不再显式声明 -->

            <!-- slf4j / logback / jackson / snakeyaml / caffeine / mysql-connector-j / commons-codec /
                 commons-lang3 / freemarker 等 Boot BOM 已托管的构件，一律沿用 BOM（需调整时只改上方属性），
                 不再在此重复声明 dependencyManagement 条目 -->
            <!-- mysql 驱动：使用新 GAV com.mysql:mysql-connector-j（旧 mysql:mysql-connector-java 已废弃）。
                 【安全CVE修复覆盖】原显式声明 8.0.33 命中 CVE-2023-22102（CVSS 8.3，修复于 8.2.0）；
                 且显式声明会连带覆盖掉 Boot BOM 托管条目自带的 protobuf-java 排除规则，
                 导致 protobuf-java 3.21.9（CVE-2024-7254）泄漏进运行时 classpath。
                 现删除显式声明，改由 spring-boot-dependencies 3.2.8 托管为 8.3.0，两个漏洞一并消除 -->

            <!-- base -->
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>${reflections.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dom4j</groupId>
                <artifactId>dom4j</artifactId>
                <version>${dom4j.version}</version>
            </dependency>
            <!-- cglib:cglib 已移除：3.3.0 是该 EOL 项目的最后一个版本（2019 年停更），其 ReflectUtils 静态块
                 需对 ClassLoader#defineClass 做 setAccessible，在 JDK 17 强封装下必抛
                 InaccessibleObjectException（module java.base does not "opens java.lang"）。
                 原 BeanCglibCopier 无任何业务代码调用，Bean 映射已统一由 MapStruct 承担 -->
            <!-- 【安全CVE修复覆盖】protobuf-java 预防性护栏，详见 properties 中说明 -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf-java.version}</version>
            </dependency>
            <!-- 【安全CVE修复覆盖】httpclient / httpclient-cache 4.5.14，修复 CVE-2020-13956 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient4.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient-cache</artifactId>
                <version>${httpclient4.version}</version>
            </dependency>
            <!-- base end -->

            <!-- apache -->
            <!-- 【安全CVE修复覆盖】commons-io 2.21.0，修复 CVE-2024-47554 并对齐 POI 5.5.1 官方要求；
                 原 2.11.0 由 easyexcel-core 3.3.2 传递引入 -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>${commons-collections4.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <!-- apache end -->

            <!-- alibaba -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>easyexcel</artifactId>
                <version>${easyexcel.version}</version>
            </dependency>
            <!-- alibaba end -->

            <!-- google -->
            <!-- zxing 核心库 -->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <!-- zxing J2SE扩展 -->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>javase</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <!-- google end -->

            <!-- jwt -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <!-- jwt end -->

            <!-- ORM -->
            <!-- MapStruct：编译期类型安全 Bean 映射（Spring 官方推荐），运行时零反射，JDK 17 无强封装问题 -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- MyBatis + PageHelper（db 中间件，供 aicyi-midware-db 使用） -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <!-- mybatis 内核版本对齐 mybatis-plus-core 3.5.7 的官方声明（3.5.16），
                 避免与 mybatis-spring-boot-starter 3.0.3 传递的 3.5.14 产生分歧 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <!-- jsqlparser 统一为 4.9：mybatis-plus 3.5.7 与 pagehelper 6.1.0 的共同安全交集。
                 mybatis-plus-extension 3.5.7 引用了 jsqlparser 4.7 中不存在的类，
                 若被就近调解到 4.7 将在运行分页插件时抛 NoClassDefFoundError -->
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
            </dependency>
            <!-- mybatis-generator-core：逆向工程生成器，子模块以 test 作用域引入，禁止在子模块写版本 -->
            <dependency>
                <groupId>org.mybatis.generator</groupId>
                <artifactId>mybatis-generator-core</artifactId>
                <version>${mybatis-generator.version}</version>
            </dependency>
            <!-- MyBatis-Plus（供 aicyi-midware-db-mybatisplus 使用）：
                 Spring Boot 3.x 必须使用 mybatis-plus-spring-boot3-starter，禁止旧的 mybatis-plus-boot-starter -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-generator</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis end -->
            <!-- ORM end -->

            <!-- cache：caffeine 版本与 Boot 3.2.8 BOM 一致（3.1.8），沿用 BOM，不再重复声明 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- cache end -->

            <!-- xxl-job -->
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>

            <!-- web：springfox 不兼容 Spring Boot 3.x，替换为 springdoc-openapi -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- web end -->

            <!-- utils -->
            <dependency>
                <groupId>com.twilio.sdk</groupId>
                <artifactId>twilio</artifactId>
                <version>${twilio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.yunpian.sdk</groupId>
                <artifactId>yunpian-java-sdk</artifactId>
                <version>${yunpian-java-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f4b6a3</groupId>
                <artifactId>uuid-creator</artifactId>
                <version>${uuid-creator.version}</version>
            </dependency>
            <!-- utils end -->
        </dependencies>
    </dependencyManagement>

    <!--    从语义来上理解 optional-->
    <!--    可选的，可以理解为此功能/此依赖可选，如果不需要某项功能，可以不引用这个包。-->

    <!--    scope provided-->
    <!--    提供的，可以理解为此包不由我直接提供，需要调用者/容器提供。-->
</project>
